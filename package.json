{
  "name": "interactive-skyline",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "data": "for c in slc lv; do uv run scripts/fetch_lidar.py $c && uv run scripts/build_terrain.py $c && uv run scripts/build_imagery.py $c && uv run scripts/build_buildings.py $c; done",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run",
    "test:live": "vitest run --config tests/live/vitest.config.js",
    "test:py": "uv run --python 3.12 --with-requirements tests/python/requirements.txt pytest -q tests/python",
    "test:e2e": "playwright test --project=webgl2-software",
    "test:e2e:drive": "playwright test --project=drive-gpu",
    "test:e2e:drive:software": "playwright test --project=drive-software",
    "test:e2e:gpu": "playwright test --project=gpu-functional --project=drive-gpu",
    "test:e2e:flight": "playwright test --project=flight-software",
    "test:flight:gpu": "playwright test --project=flight-gpu --workers=1",
    "test:goldens:update": "playwright test --project=webgl2-software baseline --update-snapshots=all",
    "test:goldens:drive:update": "playwright test --project=drive-software drive.spec --update-snapshots=changed",
    "test:perf": "playwright test --project=gpu --workers=1",
    "test:perf:drive": "playwright test --project=drive-timing --workers=1",
    "bench": "vitest bench --run --reporter=verbose",
    "test:perf:software": "playwright test --project=software-timing --workers=1",
    "test:webgpu": "playwright test --project=webgpu-software",
    "test:bench": "playwright test --project=gpu-ab bench --workers=1",
    "test:perf:ab": "playwright test --project=gpu-ab perf.ab --workers=1",
    "test:perf:update": "SKYLINE_PERF_UPDATE=1 playwright test --project=gpu --workers=1",
    "test:perf:budgets:update": "SKYLINE_PERF_UPDATE=1 playwright test --project=webgl2-software perf.budgets --workers=1"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "three": "0.187.0",
    "three-mesh-bvh": "^0.9.18"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@11.21.0"
}
